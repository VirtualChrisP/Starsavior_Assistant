{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-savior-bp.local/schemas/tychara.schema.json",
  "title": "Tychara Star Savior 公开角色资料",
  "type": "object",
  "required": ["schemaVersion", "datasetStatus", "source", "characters"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "datasetStatus": { "type": "string" },
    "source": { "type": "object" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "pageUrl", "iconUrl", "fullArtUrl", "stats", "skills"],
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "pageUrl": { "type": "string", "format": "uri" },
          "lastUpdated": { "type": ["string", "null"] },
          "profileEn": { "type": "string" },
          "iconUrl": { "type": "string", "format": "uri" },
          "fullArtUrl": { "type": "string", "format": "uri" },
          "stats": { "type": "object" },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name", "descriptionEn", "iconUrl"],
              "properties": {
                "type": { "type": "string" },
                "banner": { "type": "string" },
                "name": { "type": "string" },
                "descriptionEn": { "type": "string" },
                "iconUrl": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    }
  }
}
